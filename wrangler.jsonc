{
  // Static Astro build: no `main` entrypoint on purpose. Without this file wrangler
  // auto-detects, assumes SSR, and runs `astro add cloudflare` on its own.
  "name": "vistiq",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "dist",

    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
}
