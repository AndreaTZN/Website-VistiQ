---
import BaseLayout from "../layouts/BaseLayout.astro";
import AnnouncementBar from "../components/global/AnnouncementBar.astro";
import Nav from "../components/global/Nav.astro";
import HeroV2 from "../components/home/HeroV2.astro";
import ValueProp from "../components/home/ValueProp.astro";
import HowItWorks from "../components/home/HowItWorks.astro";
import Coverage from "../components/home/Coverage.astro";
import Benefits from "../components/home/Benefits.astro";
import Architecture from "../components/home/Architecture.astro";
import Testimonials from "../components/home/Testimonials.astro";
import Security from "../components/home/Security.astro";
import SubFooter from "../components/global/SubFooter.astro";
import FooterV2 from "../components/global/FooterV2.astro";
import Dock from "../components/ui/Dock.astro";

const title = "VistIQ: AI Investment Operating System for Private Markets";
const description =
  "VistIQ connects deal flow, portfolio data, fund activity, and external signals into a single intelligence layer. It automates extraction, monitoring, and reporting so your team stops chasing information and starts acting on it.";

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  url: "https://www.vistiq.ai/",
  logo: {
    "@type": "ImageObject",
    url: "https://cdn.prod.website-files.com/699d663f32e38d5fc7a423f9/69a564748b2cb9f6741edccb_logo.png",
  },
  name: "Vistiq",
  description:
    "VistIQ empowers VC and PE teams to analyze deals faster, monitor portfolios smarter, and make better decisions — all with AI that amplifies your capabilities.",
  sameAs: ["https://www.linkedin.com/company/vistiq-ai"],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Vistiq",
  url: "https://www.vistiq.ai/",
};
---

<BaseLayout title={title} description={description} canonical="/" animated>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
      is:inline
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
      is:inline
    />
  </Fragment>

  <main class="main-wrapper">
    <AnnouncementBar />
    <Nav belowAnnouncement />
    <HeroV2 />
    <ValueProp />
    <HowItWorks />
    <Coverage />
    <Benefits />
    <Architecture />
    <Testimonials />
    <Security />
    <SubFooter />
    <FooterV2 />
  </main>

  <Dock />
</BaseLayout>

<script>
  import "../scripts/main";
</script>
