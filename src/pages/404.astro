---
import BaseLayout from"../layouts/BaseLayout.astro";
import Button from"../components/ui/Button.astro";
---

<BaseLayout title="Not Found" canonical="/404">
  <div class="utility-page_component">
    <div class="utility-page_wrapper">
      <h3 class="h1">Page Not Found</h3>
      <div>
        The page you are looking for does not exist or has been moved<br />
      </div>
      <Button variant="secondary-white" href="/">Back to home</Button>
    </div>
  </div>
</BaseLayout>

<script>
  import { initButtonCharacterStagger } from"../scripts/buttons";

  initButtonCharacterStagger();
</script>
