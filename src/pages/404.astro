---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout title="Not Found" canonical="/404">
  <section class="error404_section">
    <div class="container-medium">
      <div class="error404_content">
        <p class="error404_eyebrow">Error 404</p>

        <p class="error404_code" aria-hidden="true">404</p>

        <div class="error404_text">
          <h1 class="error404_heading">This page went off-market</h1>
          <p class="error404_paragraph">
            The page you are looking for does not exist or has been moved.
            Let's get you back on track.
          </p>
        </div>

        <div class="error404_buttons">
          <Button variant="primary" href="/">Back to home</Button>
          <Button
            variant="secondary"
            href="https://foundersfuturecp.typeform.com/to/gTW2mUSp"
          >
            Contact us
          </Button>
        </div>
      </div>
    </div>

    <div class="error404_corner is-top-left" aria-hidden="true"></div>
    <div class="error404_corner is-top-right" aria-hidden="true"></div>
    <div class="error404_corner is-bottom-left" aria-hidden="true"></div>
    <div class="error404_corner is-bottom-right" aria-hidden="true"></div>

    <div class="error404_glow" aria-hidden="true"></div>
    <div class="noise"></div>
  </section>
</BaseLayout>

<script>
  import { initButtonCharacterStagger } from "../scripts/buttons";

  initButtonCharacterStagger();
</script>
