---
import BaseLayout from "../layouts/BaseLayout.astro";
import DemoHero from "../components/demo/DemoHero.astro";

const title = "Request a demo — See VistIQ in action";
const description =
  "Book a 30-minute walkthrough of VistIQ built around your workflow. See how investment teams centralize AI workflows and institutional memory, from sourcing and diligence to analytics and reporting.";

const demoSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Request a demo",
  url: "https://www.vistiq.ai/request-a-demo",
  description,
  isPartOf: {
    "@type": "WebSite",
    name: "Vistiq",
    url: "https://www.vistiq.ai/",
  },
};
---

<BaseLayout title={title} description={description} canonical="/request-a-demo">
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(demoSchema)}
      is:inline
    />
  </Fragment>

  <main class="main-wrapper">
    <DemoHero />
  </main>
</BaseLayout>

<script>
  import { initButtonCharacterStagger } from "../scripts/buttons";
  import { initContactForm } from "../scripts/contact-form";
  import { initDemoClose } from "../scripts/demo-close";

  initButtonCharacterStagger();
  initContactForm();
  initDemoClose();
</script>
