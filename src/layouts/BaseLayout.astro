---
import "../styles/main.css";

export interface Props {
  title: string;
  description?: string;
  /** Path only, e.g. "/404" — resolved against `site` for the canonical URL. */
  canonical?: string;
  ogImage?: string;
  /**
   * Pages whose scripts animate elements in: hides those targets from the
   * first paint until a script adds `.is-ready` on <html>, so they never
   * flash in their final state before GSAP takes over.
   */
  animated?: boolean;
  /**
   * Keeps the page out of search results. The sitemap filter in
   * astro.config.mjs must exclude the same route — a sitemap entry and a
   * noindex tag contradict each other.
   */
  noindex?: boolean;
}

const {
  title,
  description,
  canonical = Astro.url.pathname,
  ogImage = "/images/openGraph.webp",
  animated = false,
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(canonical, Astro.site);
---

<!doctype html>
<html lang="en" class:list={[{ "has-reveals": animated }]}>
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />

    {
      /* `follow` on purpose: the page is kept out of the index, but its
         outgoing links should still be crawled. */
      noindex && <meta name="robots" content="noindex, follow" />
    }

    <link rel="canonical" href={canonicalURL} />
    <link rel="shortcut icon" href="/images/favicon.png" type="image/x-icon" />
    <link rel="apple-touch-icon" href="/images/webclip.png" />

    <link
      rel="preload"
      href="/fonts/FacultyGlyphic-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Inter_18pt-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {
      /* Inline so the guard applies before any stylesheet/script loads.
         Add every new reveal target's selector here. */
      animated && (
        <style is:inline>
          .has-reveals:not(.is-ready) .hero-v2_card {
            opacity: 0;
            visibility: hidden;
          }
          /* Architecture memory: everything architecture-cards.js starts hidden. The fan
             lines hide via stroke-opacity only — the drops share this SVG. */
          .has-reveals:not(.is-ready) .architecture_memory-chip,
          .has-reveals:not(.is-ready) .architecture_memory-tag,
          .has-reveals:not(.is-ready) .architecture_memory-drop {
            opacity: 0;
            visibility: hidden;
          }
          .has-reveals:not(.is-ready) .architecture_memory-line {
            stroke-opacity: 0;
          }
          /* Architecture sources/agents/signals: entrance targets of architecture-cards.js. */
          .has-reveals:not(.is-ready) .architecture_source,
          .has-reveals:not(.is-ready) .architecture_agents-head,
          .has-reveals:not(.is-ready) .architecture_agents-ghost,
          .has-reveals:not(.is-ready) .architecture_agents-card {
            opacity: 0;
            visibility: hidden;
          }
          .has-reveals:not(.is-ready) .architecture_source-check path {
            stroke-opacity: 0;
          }
          /* Architecture "One workforce": entrance targets of initWorkforceCard. */
          .has-reveals:not(.is-ready) .architecture_workforce-head,
          .has-reveals:not(.is-ready) .architecture_workforce-ghost,
          .has-reveals:not(.is-ready) .architecture_workforce-bullet,
          .has-reveals:not(.is-ready) .architecture_workforce-step-head,
          .has-reveals:not(.is-ready) .architecture_workforce-comment {
            opacity: 0;
            visibility: hidden;
          }
          /* Scaled, not faded — these grow from zero instead of appearing.
             Each collapses on its own axis: scale(0) would zero both, and GSAP
             only animates the one axis back, leaving the other at zero. */
          .has-reveals:not(.is-ready) .architecture_workforce-divider {
            transform: scaleX(0);
          }
          .has-reveals:not(.is-ready) .architecture_workforce-line {
            transform: scaleY(0);
          }
          /* The dock slides up once the first listed section is reached. */
          .has-reveals:not(.is-ready) [data-dock] {
            opacity: 0;
            visibility: hidden;
          }
        </style>
      )
    }

    <slot name="head" />
  </head>
  <body>
    <div class="page-wrapper">
      <slot />
    </div>
  </body>
</html>
