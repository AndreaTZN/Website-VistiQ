---
/**
 * Section eyebrow: a green square followed by an uppercase label, optionally
 * underlined by a hairline rule. Every section repeated the same markup and an
 * identical copy of the CSS, so the variants that actually differed are props:
 * the alignment and the presence of the rule.
 *
 * Alignment is left by default at every width. `alignMobile` is opt-in: leave it
 * out and mobile keeps `align`, or set it to override below 767px.
 */
interface Props {
  /** Label text. Uppercased through CSS, so pass it in natural casing. */
  label: string;
  /** Alignment from 768px up, and below it unless `alignMobile` overrides. */
  align?: "left" | "center";
  /** Alignment below 768px. Defaults to `align`. */
  alignMobile?: "left" | "center";
  /** Hairline rule under the eyebrow, full width of the section. */
  line?: boolean;
  /** Extra class on the wrapper, for section-level overrides. */
  class?: string;
}

const {
  label,
  align = "left",
  alignMobile,
  line = false,
  class: className,
} = Astro.props;
---

<div
  class:list={[
    "flex w-full flex-col gap-3",
    align === "center" && "items-center",
    alignMobile === "left" && "max-mobile-landscape:items-start",
    alignMobile === "center" && "max-mobile-landscape:items-center",
    className,
  ]}
>
  <div class="flex items-center gap-3">
    <span class="h-3 w-3 flex-none bg-green" aria-hidden="true"></span>
    <span
      class="text-sm leading-normal font-semibold tracking-[0.0175rem] text-[#1d1e2199] uppercase"
      >{label}</span
    >
  </div>
  {line && <div class="h-px w-full bg-[#1d1e211a]" />}
</div>
