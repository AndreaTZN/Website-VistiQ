---
/**
 * Floating section dock — the one-page's only navigation.
 *
 * It shows the current section as a single label with a counter, and swaps that
 * label as the reader scrolls (see scripts/dock.js). The prev/next links are
 * real anchors so keyboard and no-JS navigation both work; the script only
 * upgrades them to smooth scrolling and keeps the label in sync.
 *
 * The label is rendered server-side for the first section so the dock is never
 * empty before the script runs.
 */

/** Sections listed in the dock, in document order. Hero and footers are out. */
export const DOCK_SECTIONS = [
  { id: "How-it-works", label: "How it works" },
  { id: "Lifecycle", label: "Lifecycle" },
  { id: "Data-layer", label: "Data layer" },
  { id: "Solutions", label: "Solutions" },
  /*   { id: "Investors", label: "Investors" }, */
  { id: "Data", label: "Security" },
];

const total = String(DOCK_SECTIONS.length).padStart(2, "0");
const first = DOCK_SECTIONS[0];
---

<nav
  class="fixed bottom-6 left-1/2 z-50 flex -translate-x-1/2 items-center gap-1 rounded-[100vw] border border-white/60 bg-white/75 p-1.5 shadow-[0_0.125rem_0.25rem_-0.0625rem_rgba(38,42,62,0.05),0_0.75rem_2rem_-0.5rem_rgba(38,42,62,0.18)] backdrop-blur-md max-mobile-landscape:bottom-4"
  aria-label="Sections"
  data-dock
>
  <a
    class="dock_arrow flex h-8 w-8 flex-none items-center justify-center rounded-[100vw] text-light-black no-underline hover:bg-[#1d1e2133]/6"
    href={`#${first.id}`}
    data-dock-prev
  >
    <span class="sr-only">Previous section</span>
    <svg
      width="16"
      height="16"
      viewBox="0 0 16 16"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M10 12.5 5.5 8 10 3.5"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </a>

  <p
    class="m-0 flex items-center gap-2 px-1.5 text-[0.8125rem] leading-normal font-medium whitespace-nowrap max-mobile-landscape:text-xs"
  >
    <span
      class="flex gap-0.5 text-[#1d1e2166] [font-variant-numeric:tabular-nums]"
      data-dock-counter
    >
      <span data-dock-index>01</span><span class="opacity-50">/</span>{total}
    </span>
    <span class="dock_label-slot relative block h-5 overflow-hidden">
      {/* The script measures this span, so keep it a single text node. */}
      <span class="dock_label block text-light-black" data-dock-label
        >{first.label}</span
      >
    </span>
  </p>

  <a
    class="dock_arrow flex h-8 w-8 flex-none items-center justify-center rounded-[100vw] text-light-black no-underline hover:bg-[#1d1e2133]/6"
    href={`#${DOCK_SECTIONS[1].id}`}
    data-dock-next
  >
    <span class="sr-only">Next section</span>
    <svg
      width="16"
      height="16"
      viewBox="0 0 16 16"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M6 3.5 10.5 8 6 12.5"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </a>

  {/* Announces the section change to screen readers without moving focus. */}
  <span class="sr-only" aria-live="polite" data-dock-announce></span>
</nav>
