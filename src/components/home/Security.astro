---
/** "Security & compliance". */
import Button from "../ui/Button.astro";
import Eyebrow from "../ui/Eyebrow.astro";

const PILLARS = [
  {
    number: "01",
    title: "Confidentiality",
    paragraphs: [
      "Your organization data are fully isolated by design, ensuring strict separation between clients.",
      "Your data is not used to train LLM models.",
    ],
  },
  {
    number: "02",
    title: "Auditability",
    paragraphs: [
      "Every AI-generated output is backed by a traceable source. Click any reference number to access the source document.",
      "Comprehensive audit logs provide full visibility into AI and user modifications.",
    ],
  },
  {
    number: "03",
    title: "Confidentiality",
    paragraphs: [
      "Your proprietary data are hosted within the EU, following strict enterprise-grade security standards.",
    ],
  },
];
---

<section id="Data" class="security_section">
  <div class="container-medium">
    <div class="security_header">
      <Eyebrow label="Security & compliance" line />

      <div class="security_intro">
        <div class="security_intro-text">
          <h2 class="heading">
            <span>Built for confidentiality,</span>
            <span>auditability and security</span>
          </h2>
          <p class="security_paragraph">
            Designed from day one with the compliance teams of investment funds.
          </p>
        </div>
        <div class="security_buttons">
          <Button
            variant="primary"
            href="/request-a-demo"
          >
            Request a demo
          </Button>
          <Button
            variant="secondary"
            href="/contact"
          >
            Contact us
          </Button>
        </div>
      </div>
    </div>
    <ol class="security_pillars">
      {
        PILLARS.map((pillar) => (
          <li class="security_pillar">
            <div class="security_pillar-line" />
            <div class="security_pillar-body">
              <p class="security_pillar-number">{pillar.number}</p>
              <div class="security_pillar-text">
                <h3 class="security_pillar-title">{pillar.title}</h3>
                {pillar.paragraphs.map((paragraph) => (
                  <p class="security_pillar-paragraph">{paragraph}</p>
                ))}
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
