---
/** "Security & compliance". */
import Button from "../ui/Button.astro";
import Eyebrow from "../ui/Eyebrow.astro";

const PILLARS = [
  {
    number: "01",
    title: "Data Governance",
    paragraphs: [
      "Your firm controls how proprietary information is connected, structured and accessed.",
    ],
  },
  {
    number: "02",
    title: "Permissions & Confidentiality",
    paragraphs: [
      "Organizational data is isolated by design and access follows the firm’s permission model. Your proprietary data is not used to train underlying LLMs..",
    ],
  },
  {
    number: "03",
    title: "Auditability & Source Traceability",
    paragraphs: [
      "Every AI-generated output can be traced back to its underlying source, with comprehensive logs across user and AI activity.",
    ],
  },
  {
    number: "04",
    title: "Agent Governance",
    paragraphs: [
      "Define what agents can access, what they can do autonomously and where human approval is required.",
    ],
  },
];
---

<section id="Data" class="security_section">
  <div class="container-medium">
    <div class="security_header">
      <Eyebrow label="Security & compliance" line />

      <div class="security_intro">
        <div class="security_intro-text">
          <h2 class="heading">
            <span>Autonomy requires governance</span>
          </h2>
          <p class="security_paragraph">
            VistIQ is designed from the ground up for the confidentiality and
            governance requirements of private markets. Every user, data source,
            AI output and agent action operates within a controlled and
            auditable environment.
          </p>
        </div>
        <div class="security_buttons">
          <Button variant="primary" href="/request-a-demo">
            Request a demo
          </Button>
        </div>
      </div>
    </div>
    <ol class="security_pillars">
      {
        PILLARS.map((pillar) => (
          <li class="security_pillar">
            <div class="security_pillar-line" />
            <div class="security_pillar-body">
              <p class="security_pillar-number">{pillar.number}</p>
              <div class="security_pillar-text">
                <h3 class="security_pillar-title">{pillar.title}</h3>
                {pillar.paragraphs.map((paragraph) => (
                  <p class="security_pillar-paragraph">{paragraph}</p>
                ))}
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
