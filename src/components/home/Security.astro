---
/** "Security & compliance". */
import Button from "../ui/Button.astro";
import Eyebrow from "../ui/Eyebrow.astro";

const PILLARS = [
  {
    number: "01",
    title: "Data Governance",
    paragraphs: [
      "Your firm controls how proprietary information is connected, structured and accessed.",
    ],
  },
  {
    number: "02",
    title: "Permissions & Confidentiality",
    paragraphs: [
      "Organizational data is isolated by design and access follows the firm’s permission model. Your proprietary data is not used to train underlying LLMs.",
    ],
  },
  {
    number: "03",
    title: "Auditability & Source Traceability",
    paragraphs: [
      "Every AI-generated output can be traced back to its underlying source, with comprehensive logs across user and AI activity.",
    ],
  },
  {
    number: "04",
    title: "Agent Governance",
    paragraphs: [
      "Define what agents can access, what they can do autonomously and where human approval is required.",
    ],
  },
];
---

<section id="Data" class="w-full bg-white py-25 max-mobile-landscape:py-14">
  <div class="container-medium">
    <div class="flex flex-col items-start gap-6">
      <Eyebrow label="Security & compliance" line />

      <div
        class="flex w-full justify-between gap-8 max-tablet:flex-col max-tablet:items-start max-tablet:gap-8"
      >
        <div class="flex flex-col items-start gap-4">
          <h2 class="heading font-facultyglyphic">
            <span>Autonomy requires governance</span>
          </h2>
          <p
            class="m-0 max-w-194 text-xl leading-normal text-[#1d1e2199] max-mobile-landscape:text-lg"
          >
            VistIQ is designed from the ground up for the confidentiality and
            governance requirements of private markets. Every user, data source,
            AI output and agent action operates within a controlled and
            auditable environment.
          </p>
        </div>
        <div class="flex items-center gap-4">
          <Button variant="primary" href="/request-a-demo">
            Request a demo
          </Button>
        </div>
      </div>
    </div>
    <ol
      class="m-0 mt-12 grid list-none grid-cols-4 gap-x-6 gap-y-10 pl-0 max-tablet:grid-cols-1 max-mobile-landscape:mt-10"
    >
      {
        PILLARS.map((pillar) => (
          <li class="flex flex-col items-start gap-6">
            <div class="h-0.5 w-full bg-[#1d1e211a]" />
            <div class="flex w-full flex-col items-start gap-3 max-tablet:flex-row">
              <p class="m-0 flex-none text-center font-facultyglyphic text-4xl leading-normal font-normal text-green max-tablet:w-14 max-mobile-landscape:text-3xl">
                {pillar.number}
              </p>
              <div class="flex flex-col [&>p+p]:mt-6">
                <h3 class="m-0 font-inter text-lg leading-normal font-medium text-light-black">
                  {pillar.title}
                </h3>
                {pillar.paragraphs.map((paragraph) => (
                  <p class="m-0 text-base leading-normal text-[#1d1e2199]">
                    {paragraph}
                  </p>
                ))}
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
