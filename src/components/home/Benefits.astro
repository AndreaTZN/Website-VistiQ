---
import { Image } from "astro:assets";

import Corners from "../ui/Corners.astro";
import Eyebrow from "../ui/Eyebrow.astro";

import askAnything from "../../assets/benefits/ask-anything.png";
import automatic from "../../assets/benefits/automatic.png";
import collab from "../../assets/benefits/collab.png";
import connectors from "../../assets/benefits/connectors.png";
import portfolio from "../../assets/benefits/portfolio.png";
import reporting from "../../assets/benefits/reporting.png";

const ITEMS = [
  {
    eyebrow: "Ask anything",
    title: "Ask anything",
    body: "Get instant, sourced answers across every deal, company, fund, document and conversation.",
    visual: askAnything,
  },
  {
    eyebrow: "AUTOMATIC DATA ENTRY",
    title: "Eliminate manual data entry",
    body: "New documents and reporting are automatically read, structured and integrated into the relevant investment context.",
    visual: automatic,
  },
  /*  {
    eyebrow: "CONNECTORS",
    title: "Connected to your data and to the tools your team already works in",

    body: "Gmail, Outlook, Google Drive, Excel and your dataroom. Documents reach VistiQ where they already land no new habit to adopt, no folder to maintain.",
    visual: connectors,
  }, */
  {
    eyebrow: "Portfolio monitoring",
    title: "Monitor continuously",
    body: "Every portfolio company, competitor and market can be monitored continuously for changes, risks and opportunities.",
    visual: portfolio,
  },
  {
    eyebrow: "COLLABORATIVE DEALFLOW",
    title: "Scale your investment capacity",
    body: "Analyze more opportunities and monitor portfolios more deeply without increasing headcount proportionally.",
    visual: collab,
  },
  {
    eyebrow: "Fund operations and reporting",
    title: "Prepare automatically",
    body: "Investment materials, portfolio reviews and reporting are continuously prepared from the latest available information.",
    visual: reporting,
  },
];
---

<section id="Solutions" class="benefits_section">
  <div class="container-medium">
    <div class="benefits_header">
      <Eyebrow label="What it does for you" line />
      <h2 class="heading">
        <span>10x your investment team. </span><span>Not your headcount.</span>
      </h2>
      <p class="benefits_paragraph">
        From first look to final exit, VistIQ brings intelligence, memory and
        autonomous execution into every investment workflow.
      </p>
    </div>

    <div class="benefits_layout">
      <div class="benefits_accordion" data-accordion>
        {
          ITEMS.map((item, index) => (
            <div class="benefits_item" data-accordion-item>
              {/* Per-slide visual, mobile only — the desktop layout uses the
                  single shared one below and hides these. */}
              <div class="benefits_item-visual" aria-hidden="true">
                {item.visual && (
                  <Image
                    class="benefits_illu"
                    src={item.visual}
                    alt=""
                    widths={[652, 1304]}
                    sizes="(max-width: 767px) 92vw, 0px"
                    loading="lazy"
                  />
                )}
                <Corners />
                <div class="noise" />
              </div>
              <div class="benefits_item-line" />
              <h3 class="benefits_item-heading">
                <button
                  type="button"
                  class="benefits_item-trigger"
                  data-accordion-trigger
                  aria-expanded={index === 0 ? "true" : "false"}
                  aria-controls={`benefits-panel-${index}`}
                  id={`benefits-trigger-${index}`}
                >
                  <span class="benefits_item-eyebrow">
                    <span
                      class="benefits_item-square"
                      data-accordion-square
                      aria-hidden="true"
                    />
                    <span class="benefits_item-eyebrow-label">
                      {item.eyebrow}
                    </span>
                  </span>
                  <span class="benefits_item-title">{item.title}</span>
                </button>
              </h3>
              {item.body && (
                <div
                  class="benefits_item-panel"
                  data-accordion-panel
                  id={`benefits-panel-${index}`}
                  role="region"
                  aria-labelledby={`benefits-trigger-${index}`}
                >
                  <p class="benefits_item-body">{item.body}</p>
                </div>
              )}
            </div>
          ))
        }
      </div>

      <div class="benefits_visual" data-accordion-visual>
        {
          /* One illustration per item, stacked; accordion.js cross-fades to
            the one matching the open panel. */
        }
        {
          ITEMS.map((item, index) =>
            item.visual ? (
              <Image
                class="benefits_illu"
                data-accordion-illu={index}
                src={item.visual}
                alt=""
                widths={[652, 1304]}
                sizes="(min-width: 768px) 40vw, 0px"
                loading="lazy"
              />
            ) : null,
          )
        }
        <Corners />
        <div class="noise"></div>
      </div>
    </div>
  </div>
</section>
