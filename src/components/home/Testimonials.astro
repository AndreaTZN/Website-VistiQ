---
/**
 * "They trust us". Auto-playing testimonial carousel;
 * the transitions live in scripts/testimonials.js.
 *
 * One slide and one progress bar per entry: add or remove testimonials here
 * and the carousel follows.
 */
import { Image } from "astro:assets";

import Corners from "../ui/Corners.astro";
import Eyebrow from "../ui/Eyebrow.astro";
// Imported, not a public/ path: that is what lets astro:assets emit the
// WebP variants and the srcset. The logo stays in public/ — SVGs are copied
// as-is either way.
import thibaultMagnen from "../../assets/testimonials/thibault-magnen.jpg";

const TESTIMONIALS = [
  {
    quote:
      "Every number on our dashboard traces straight back to the source document with one click. That level of audit-readiness is exactly what our LPs expect from us.",
    name: "Thibault Magnen",
    role: "Senior Associate",
    logo: "/images/testimonials/founders-future.svg",
    logoAlt: "Founders Future",
    portrait: thibaultMagnen,
    portraitAlt: "Portrait of Thibault Magnen, Senior Associate.",
  },
  {
    quote:
      "Every number on our dashboard traces straight back to the source document with one click.",
    name: "Thibault",
    role: "Senior Associate",
    logo: "/images/testimonials/founders-future.svg",
    logoAlt: "Founders Future",
    portrait: thibaultMagnen,
    portraitAlt: "Portrait of Thibault Magnen, Senior Associate.",
  },
];
---

<section
  id="Investors"
  class="relative z-0 w-full bg-beige-dark py-25 max-mobile-landscape:py-14"
>
  <div class="container-medium">
    <div class="flex flex-col items-start gap-6">
      <Eyebrow label="They trust us" line />
      <div>
        <h2 class="heading font-facultyglyphic">Adopted by industry leaders</h2>
        <p class="text-xl leading-normal text-[#1d1e2199] mt-4">
          Built with investment teams. Designed for the standards of
          institutional private markets.
        </p>
      </div>
    </div>

    <div
      class="relative mt-12 grid grid-cols-[minmax(0,600fr)_minmax(0,377fr)] gap-8 bg-[#4a4441] max-mobile-landscape:mt-10 max-mobile-landscape:grid-cols-[minmax(0,1fr)]"
      data-testimonials
      aria-roledescription="carousel"
      aria-label="Customer testimonials"
    >
      <div
        class="flex flex-col items-start gap-8 p-12 max-mobile-landscape:gap-8 max-mobile-landscape:p-4"
      >
        <div class="relative grid">
          {
            TESTIMONIALS.map((item, index) => (
              <div
                class="testimonials_text [grid-area:1/1] flex flex-col items-start max-mobile-landscape:gap-8"
                data-testimonial-text
                aria-roledescription="slide"
                aria-label={`${index + 1} of ${TESTIMONIALS.length}`}
                aria-hidden={index === 0 ? "false" : "true"}
              >
                <img
                  class="h-auto w-[7.3rem]"
                  data-testimonial-logo
                  src={item.logo}
                  alt={item.logoAlt}
                  width="117"
                  height="48"
                  loading="lazy"
                />
                <p
                  class="mt-14 mb-8 max-w-150 text-xl leading-normal text-white max-mobile-landscape:mt-0 max-mobile-landscape:mb-0"
                  data-testimonial-quote
                >
                  {item.quote}
                </p>
                <div class="flex flex-col" data-testimonial-author>
                  <p class="m-0 text-[1.375rem] leading-normal font-medium text-white">
                    {item.name}
                  </p>
                  <p class="m-0 text-base leading-normal text-white/60">
                    {item.role}
                  </p>
                </div>
              </div>
            ))
          }
        </div>

        <div class="mt-auto flex gap-2">
          {
            TESTIMONIALS.map((_, index) => (
              <button
                type="button"
                class="relative h-[2px] w-8 overflow-hidden border-0 bg-white/20 p-0"
                data-testimonial-dot
                aria-label={`Show testimonial ${index + 1}`}
              >
                <span
                  class="absolute inset-0 block h-full w-full origin-left scale-x-0 bg-white"
                  data-testimonial-dot-fill
                />
              </button>
            ))
          }
        </div>
      </div>

      <div class="relative grid max-mobile-landscape:order-[-1]">
        {
          TESTIMONIALS.map((item, index) => (
            <div
              class="testimonials_picture [grid-area:1/1] aspect-square w-full self-start p-5 max-mobile-landscape:p-4"
              data-testimonial-picture
              aria-hidden={index === 0 ? "false" : "true"}
            >
              <div class="relative h-full w-full">
                <Image
                  src={item.portrait}
                  alt={item.portraitAlt}
                  widths={[377, 754]}
                  sizes="(max-width: 767px) 92vw, 30vw"
                  loading="lazy"
                  class="image-fit-cover"
                />
                <Corners />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="noise"></div>
</section>
