---
/**
 * "How it runs". Four cards; the first one shows the connected data sources
 * as tags.
 */
import Eyebrow from "../ui/Eyebrow.astro";

/** Data source tags, in design order. */
const DATA_SOURCES = [
  { name: "Google Drive", logo: "google-drive" },
  { name: "One Drive", logo: "one-drive" },
  { name: "Google Calendar", logo: "google-calendar" },
  { name: "Dropbox", logo: "dropbox" },
  { name: "Affinity", logo: "affinity" },
  { name: "Akta", logo: "akta" },
  { name: "Dealroom", logo: "dealroom" },
  { name: "Crunchbase", logo: "crunchbase" },
  { name: "Perplexity", logo: "perplexity" },
  { name: "Granola", logo: "granola" },
  { name: "Excel", logo: "excel" },
  { name: "Gmail", logo: "gmail" },
  { name: "Microsoft", logo: "microsoft" },
  { name: "Outlook", logo: "outlook" },
  { name: "Pappers", logo: "pappers" },
  { name: "Notion", logo: "notion" },
];

/** Agent notifications for the "Agents" card visual. */
const AGENT_NOTIFICATIONS = [
  {
    icon: "/images/integrations/google-calendar.png",
    iconClass: "is-calendar",
    title: "Calendar agent",
    time: "2m ago",
    tag: "Deal",
    lead: 'Tomorro: upcoming meeting "board tomorro" on 2026-08-10 at 11:00 to 12:00',
    lines: [
      "Organizer: severine@vistiq.ai",
      "Meeting: board tomorro, 2026-08-10 at 11:00 to 12:00",
    ],
  },
  {
    icon: "/images/architecture/warning-triangle.svg",
    iconClass: "is-warning",
    title: "Monitoring agent",
    time: "9m ago",
    tag: "Risk",
    lead: "Runway alert · Northlane (Fund II)",
    lines: [
      "Metrics extracted from data room, comps benchmarked, red flags highlighted.",
    ],
  },
];

/**
 * Signal notifications for the "Signal & event" card visual.
 * Titles are arrays: each entry is one forced line, as in the design.
 */
const SIGNAL_NOTIFICATIONS = [
  {
    title: ["Cinderlake signs 3 utility-scale clients", "(+€2.1M ARR)"],
    meta: ["Insight", "Cinderlake"],
  },
  {
    title: ["Wavely named in a top 50 EU", "climate-tech list"],
    meta: ["Signal", "Sifted"],
  },
  {
    title: ["Cinderlake competitor raises €20M"],
    meta: ["Signal", "Watch"],
  },
];

/**
 * Fan lines of the "Memory" visual, drawn bottom → top (each path starts at a
 * tag and ends under the chip). The droplets in architecture-cards.js follow them
 * with motionPath from start:1 to end:0, i.e. pouring chip → tags.
 */
const TENTACLE_PATHS = [
  "M169.732 79.464V.69",
  "M68.375 64.742s2.622-13.647 17.783-25.417 50.022-7.55 56.886-16.392C150.799 12.943 155.253.5 155.253.5",
  "M271.09 64.742s-2.623-13.518-17.784-25.317c-15.162-11.8-50.022-7.57-56.886-16.435C188.665 12.974 184.211.5 184.211.5",
  "M.5 79.464s2.866-36.551 34.358-48.515c29.777-10.41 75.931-6.367 85.166-12.271C135.365 8.871 140.773.69 140.773.69",
  "M338.954 79.464s-2.866-36.551-34.357-48.515c-29.778-10.41-75.932-6.367-85.167-12.271C204.09 8.871 198.681.69 198.681.69",
];

/** Capability tags for the "Memory" card visual. */
const MEMORY_TAGS = [
  { label: "Data", logo: "tag-data" },
  { label: "Connectors", logo: "tag-connectors" },
  { label: "Memory", logo: "tag-memory" },
  { label: "Business context", logo: "tag-business" },
  { label: "Security", logo: "tag-security" },
  { label: "Orchestration", logo: "tag-orchestration" },
  { label: "Agents", logo: "tag-agents" },
];

/**
 * "One workforce" timeline — the deal thread shown in the full-width card.
 * `tag` is optional; the last step is still open, hence `pending`.
 */
const WORKFORCE_STEPS = [
  {
    title: "Pitch deck received",
    tag: "scored 82 / thesis",
    date: "12 Mar",
    author: "Séverine",
    avatar: { initials: "SG" },
    comment:
      "Fits the agri-industrial thesis. Closest comparable in our history: Novaflow, 2023.",
  },
  {
    title: "IC memo drafted",
    tag: "+ generated from deck + 2 calls",
    date: "14 Mar",
    author: "Abhishek",
    avatar: { initials: "AB" },
    comment: "Reworked the unit economics section, churn is not disclosed.",
  },
  {
    title: "Investment committee — approved",
    date: "21 Mar",
    author: "Marc",
    avatar: { initials: "MA" },
    comment:
      "Approved, subject to two reference calls and the ESOP being clarified.",
  },
  {
    title: "Term sheet sent",
    date: "24 Mar",
    author: "Marc",
    avatar: { initials: "MA" },
    comment: "€4M for 14%, two weeks of exclusivity.",
  },
  {
    title: "Meeting minutes",
    tag: "+ transcribed",
    date: "28 Mar",
    author: "Abhishek",
    avatar: { initials: "AB" },
    comment: "Founders aligned on the ESOP. Full minutes filed to the company.",
  },
  {
    title: "Reference calls",
    tag: "3 of 5 done",
    date: "in progress",
    pending: true,
    author: "Séverine",
    avatar: { initials: "SG" },
    comment: "Two customers left to call. Notes go straight into the file.",
  },
];

const CARDS = [
  {
    title: "Connectors One governed data layer. Always up to date.",
    body: "Connect once. VistIQ keeps your firm’s intelligence continuously synchronized. Connect your CRM, email, cloud storage, data rooms, portfolio systems and external data sources. VistIQ continuously ingests, structures and contextualizes new information while preserving permissions, ownership and source traceability.",
    modifier: "is-sources",
  },
  {
    title: "Agents our autonomous investment team",
    body: "Specialized AI agents that work continuously across your firm, monitoring, analyzing, preparing and executing. They understand context, coordinate work and act.",
    modifier: "is-agents",
  },
  {
    title: "One workforce. Humans and AI agents, working together.",
    body: "On every deal, humans and agents investigate together: analyzing documents, researching markets, challenging assumptions, coordinating diligence, preparing investment cases and moving work forward. Partners bring judgment and conviction. Investment teams bring expertise and relationships. Agents bring continuous intelligence and execution. One deal. One context. One memory. One workforce.",
    modifier: "is-workforce",
  },
  {
    title: "Signal & event",
    body: "Daily monitoring of your portfolio companies, their competitors and their markets",
    modifier: "is-informations",
  },
  {
    title: "Memory",
    body: "Every deal, company, interaction and decision becomes part of your firm’s collective intelligence. VistIQ continuously builds and maintains the context behind every investment — documents, conversations, analyses, decisions and historical data.",
    modifier: "is-memory",
  },
];
---

<section id="Data-layer" class="architecture_section">
  <div class="container-medium">
    <div class="architecture_header">
      <Eyebrow label="How it runs" line />
      <h2 class="heading font-facultyglyphic">
        <span>One governed data layer.</span>
        <span>Always up to date.</span>
      </h2>
    </div>

    <div class="architecture_cards">
      {
        CARDS.map((card) => (
          <div class={`architecture_card ${card.modifier}`}>
            <div class="architecture_card-visual">
              {card.modifier === "is-sources" && (
                <div class="architecture_sources">
                  {DATA_SOURCES.map((source) => (
                    <span class="architecture_source">
                      <span class="architecture_source-logo">
                        <img
                          src={`/images/integrations/${source.logo}.png`}
                          alt=""
                          loading="lazy"
                          width="20"
                          height="20"
                        />
                      </span>
                      <span class="architecture_source-name">
                        {source.name}
                      </span>
                      <span
                        class="architecture_source-line"
                        aria-hidden="true"
                      />
                      <svg
                        class="architecture_source-check"
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 16 16"
                        fill="none"
                        aria-hidden="true"
                      >
                        <path
                          d="m4 8.5 2.5 2.5L12 5.5"
                          stroke="#22AD01"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </span>
                  ))}
                </div>
              )}
              {card.modifier === "is-memory" && (
                <div class="architecture_memory">
                  <div class="architecture_memory-chip">
                    <span class="architecture_memory-chip-inner">
                      <img
                        src="/images/architecture/iq-logo.svg"
                        alt=""
                        loading="lazy"
                      />
                    </span>
                  </div>
                  <span class="architecture_memory-tentacle" aria-hidden="true">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 340 80"
                      fill="none"
                    >
                      <g stroke="#fff" stroke-linecap="round" opacity=".8">
                        {TENTACLE_PATHS.map((d) => (
                          <path class="architecture_memory-line" d={d} />
                        ))}
                      </g>
                      <g fill="#2aa555">
                        {TENTACLE_PATHS.map((_, i) => (
                          <>
                            <circle
                              class="architecture_memory-drop"
                              data-line={i}
                              r="2.2"
                              cx="-10"
                              cy="-10"
                            />
                            <circle
                              class="architecture_memory-drop"
                              data-line={i}
                              r="1.5"
                              cx="-10"
                              cy="-10"
                            />
                          </>
                        ))}
                      </g>
                    </svg>
                  </span>
                  <div class="architecture_memory-tags">
                    {MEMORY_TAGS.map((tag) => (
                      <span class="architecture_memory-tag">
                        <img
                          class="architecture_memory-tag-logo"
                          src={`/images/architecture/${tag.logo}.svg`}
                          alt=""
                          loading="lazy"
                        />
                        {tag.label}
                        <span
                          class="architecture_memory-spinner"
                          aria-hidden="true"
                        >
                          <img
                            src="/images/architecture/spinner.svg"
                            alt=""
                            loading="lazy"
                          />
                        </span>
                      </span>
                    ))}
                  </div>
                </div>
              )}
              {card.modifier === "is-informations" && (
                <div class="architecture_agents is-signals">
                  <div class="architecture_agents-stack">
                    <span
                      class="architecture_agents-ghost"
                      aria-hidden="true"
                    />
                    {SIGNAL_NOTIFICATIONS.map((n) => (
                      <div class="architecture_agents-card">
                        <span class="architecture_agents-icon">
                          <img
                            src="/images/architecture/bell.svg"
                            alt=""
                            loading="lazy"
                          />
                        </span>
                        <div class="architecture_agents-text">
                          <div class="architecture_agents-h1">
                            <span class="architecture_agents-h1-lines">
                              {n.title.map((line) => (
                                <span>{line}</span>
                              ))}
                            </span>
                            <span
                              class="architecture_agents-unread"
                              aria-hidden="true"
                            />
                          </div>
                          <p class="architecture_agents-meta">
                            {n.meta.map((part, i) => (
                              <>
                                {i > 0 && (
                                  <span
                                    class="architecture_agents-sep"
                                    aria-hidden="true"
                                  />
                                )}
                                {part}
                              </>
                            ))}
                          </p>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}
              {card.modifier === "is-workforce" && (
                <div class="architecture_workforce">
                  {/* Two offset ghosts read as a stack of deals behind the open one. */}
                  <span
                    class="architecture_workforce-ghost is-back"
                    aria-hidden="true"
                  />
                  <span
                    class="architecture_workforce-ghost is-mid"
                    aria-hidden="true"
                  />
                  <div class="architecture_workforce-card">
                    <div class="architecture_workforce-head">
                      <div class="architecture_workforce-head-text">
                        <p class="architecture_workforce-title">
                          Agriloop — Series B opportunity
                        </p>
                        <p class="architecture_workforce-meta">
                          €12M round · FF II · opened 12 March
                        </p>
                      </div>
                      <div class="architecture_workforce-avatars">
                        <span class="architecture_workforce-avatar">SG</span>
                        <span class="architecture_workforce-avatar is-alt">
                          AB
                        </span>
                        <span class="architecture_workforce-avatar is-alt2">
                          MA
                        </span>
                        <span class="architecture_workforce-avatar is-more">
                          +2
                        </span>
                      </div>
                    </div>
                    <span
                      class="architecture_workforce-divider"
                      aria-hidden="true"
                    />
                    <div class="architecture_workforce-steps">
                      {WORKFORCE_STEPS.map((step) => (
                        <div class="architecture_workforce-step">
                          <div class="architecture_workforce-connector">
                            <span
                              class={`architecture_workforce-bullet ${step.pending ? "is-pending" : ""}`}
                              aria-hidden="true"
                            >
                              {!step.pending && (
                                <svg
                                  xmlns="http://www.w3.org/2000/svg"
                                  viewBox="0 0 16 16"
                                  fill="none"
                                >
                                  <path
                                    d="m4 8.5 2.5 2.5L12 5.5"
                                    stroke="#fff"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                  />
                                </svg>
                              )}
                            </span>
                            <span
                              class="architecture_workforce-line"
                              aria-hidden="true"
                            />
                          </div>
                          <div class="architecture_workforce-body">
                            <div class="architecture_workforce-step-head">
                              <span class="architecture_workforce-step-title">
                                {step.title}
                              </span>
                              {step.tag && (
                                <span class="architecture_workforce-tag">
                                  {step.tag}
                                </span>
                              )}
                              <span
                                class={`architecture_workforce-date ${step.pending ? "is-pending" : ""}`}
                              >
                                {step.date}
                              </span>
                            </div>
                            <div class="architecture_workforce-comment">
                              <span class="architecture_workforce-avatar">
                                {step.avatar.initials}
                              </span>
                              <p class="architecture_workforce-comment-text">
                                <strong>{step.author}</strong> : {step.comment}
                              </p>
                            </div>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              )}
              {card.modifier === "is-agents" && (
                <div class="architecture_agents">
                  <div class="architecture_agents-head">
                    <p class="architecture_agents-title">Agents running (8)</p>
                    <span class="architecture_agents-live">
                      <span
                        class="architecture_agents-live-dot"
                        aria-hidden="true"
                      >
                        <img
                          src="/images/architecture/live-dot.svg"
                          alt=""
                          loading="lazy"
                        />
                      </span>
                      Running 24/7
                    </span>
                  </div>
                  <div class="architecture_agents-stack">
                    <span
                      class="architecture_agents-ghost"
                      aria-hidden="true"
                    />
                    {AGENT_NOTIFICATIONS.map((n) => (
                      <div class="architecture_agents-card">
                        <span class={`architecture_agents-icon ${n.iconClass}`}>
                          <img src={n.icon} alt="" loading="lazy" />
                        </span>
                        <div class="architecture_agents-text">
                          <div class="architecture_agents-h1">
                            <span>{n.title}</span>
                            <span
                              class="architecture_agents-unread"
                              aria-hidden="true"
                            />
                          </div>
                          <p class="architecture_agents-meta">
                            {n.time}
                            <span
                              class="architecture_agents-sep"
                              aria-hidden="true"
                            />
                            {n.tag}
                          </p>
                          <p class="architecture_agents-lead">{n.lead}</p>
                          {n.lines.map((line) => (
                            <p class="architecture_agents-line">{line}</p>
                          ))}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
            <div class="architecture_card-text">
              <h3 class="architecture_card-title">{card.title}</h3>
              <p class="architecture_card-body">{card.body}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
  <div class="architecture_texture" aria-hidden="true"></div>
  <div class="noise"></div>
</section>
