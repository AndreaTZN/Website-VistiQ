---
/** Steps of the investment lifecycle. */
import Corners from "../ui/Corners.astro";
import Eyebrow from "../ui/Eyebrow.astro";

const STEPS = [
  {
    number: "01",
    title: "Deal Assessment",
    bullets: [
      "Screen opportunities",
      "Analyze decks",
      "Assess risks",
      "Benchmark companies and prepare investment cases",
    ],
  },
  {
    number: "02",
    title: "Deal Execution",
    bullets: [
      "Coordinate diligence",
      "Track open questions",
      "Centralize findings and move the entire deal team toward a decision",
    ],
  },
  {
    number: "03",
    title: "Portfolio Management",
    bullets: [
      "Continuously monitor financial and operating performance reporting",
      "Boards",
      "Risks",
      "Opportunities and market signals",
    ],
  },
  {
    number: "04",
    title: "Valuation",
    bullets: [
      "Maintain valuation context",
      "Comparable companies financing history and scenarios from continuously updated information",
    ],
  },
  {
    number: "05",
    title: "Governance & Compliance",
    bullets: [
      "Maintain investment records",
      "Approvals",
      "Documentation and audit trails across funds and vehicles",
    ],
  },
  {
    number: "06",
    title: "Reporting & Investor Relations",
    bullets: [
      "Turn portfolio and fund data into continuously updated internal and LP reporting",
    ],
  },
];
---

<section id="Lifecycle" class="coverage_section">
  <div class="coverage_pattern" aria-hidden="true"></div>

  <Corners />

  <div class="container-medium">
    <div class="coverage_header">
      <Eyebrow label="End-to-end coverage" align="center" />
      <h2 class="heading is-centered">
        <span>AI agents across the entire </span>
        <span>investment lifecycle</span>
      </h2>
      <p class="coverage_paragraph">
        From first look to final exit, VistIQ brings intelligence, memory and
        autonomous execution into every investment workflow.
      </p>
    </div>

    <div class="coverage_slider" data-coverage-slider>
      <div class="coverage_viewport" data-coverage-viewport>
        <ol class="coverage_steps" data-coverage-track>
          {
            STEPS.map((step) => (
              <li class="coverage_step" data-coverage-step>
                <div class="coverage_step-line" />
                <p class="coverage_step-number">{step.number}</p>
                <div class="coverage_step-text">
                  <h3 class="coverage_step-title">{step.title}</h3>
                  <ul class="coverage_step-body">
                    {step.bullets.map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="coverage_controls" data-coverage-controls hidden>
        <button
          type="button"
          class="coverage_arrow is-prev"
          data-coverage-prev
          aria-label="Previous steps"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              d="M15 5 8 12l7 7"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>

        <div class="coverage_dots" data-coverage-dots></div>

        <button
          type="button"
          class="coverage_arrow is-next"
          data-coverage-next
          aria-label="Next steps"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              d="m9 5 7 7-7 7"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>
