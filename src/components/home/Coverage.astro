---
/** Steps of the investment lifecycle. */
import Button from "../ui/Button.astro";
import Corners from "../ui/Corners.astro";
import Eyebrow from "../ui/Eyebrow.astro";

const STEPS = [
  {
    number: "01",
    title: "Deal Assessment",
    bullets: [
      "Screen opportunities",
      "Analyze decks",
      "Assess risks",
      "Benchmark companies and prepare investment cases",
    ],
  },
  {
    number: "02",
    title: "Deal Execution",
    bullets: [
      "Coordinate diligence",
      "Track open questions",
      "Centralize findings and move the entire deal team toward a decision",
    ],
  },
  {
    number: "03",
    title: "Portfolio Management",
    bullets: [
      "Continuously monitor financial and operating performance reporting",
      "Boards",
      "Risks",
      "Opportunities and market signals",
    ],
  },
  {
    number: "04",
    title: "Valuation",
    bullets: [
      "Maintain valuation context",
      "Comparable companies financing history and scenarios from continuously updated information",
    ],
  },
  {
    number: "05",
    title: "Governance & Compliance",
    bullets: [
      "Maintain investment records",
      "Approvals",
      "Documentation and audit trails across funds and vehicles",
    ],
  },
  {
    number: "06",
    title: "Reporting & Investor Relations",
    bullets: [
      "Turn portfolio and fund data into continuously updated internal and LP reporting",
    ],
  },
];
---

<section
  id="Lifecycle"
  class="coverage_section relative z-0 w-full overflow-hidden py-25 max-mobile-landscape:py-14"
>
  <div
    class="coverage_pattern pointer-events-none absolute inset-0 -z-10 opacity-10 mask-[radial-gradient(ellipse_60%_55%_at_50%_50%,#0000_0%,#0000_40%,#000_100%)]"
    aria-hidden="true"
  >
  </div>

  <Corners />

  <div class="container-medium">
    <div class="flex flex-col items-center gap-6 text-center">
      <Eyebrow label="End-to-end coverage" align="center" />
      <h2 class="heading is-centered font-facultyglyphic">
        <span>AI agents across the entire </span>
        <span>investment lifecycle</span>
      </h2>
      <p class="m-0 max-w-194 text-xl leading-normal text-[#1d1e2199]">
        From first look to final exit, VistIQ brings intelligence, memory and
        autonomous execution into every investment workflow.
      </p>
    </div>

    <ol
      class="m-0 mt-12 grid list-none grid-cols-3 gap-px border border-[#e8e8e9] bg-[#e8e8e9] pl-0 max-tablet:grid-cols-2 max-mobile-landscape:mt-10 max-mobile-landscape:grid-cols-1"
    >
      {
        STEPS.map((step) => (
          <li class="group/step relative flex min-h-90 flex-col items-start gap-3 bg-white p-8 pt-20 transition-shadow duration-600 ease-[cubic-bezier(0.625,0.05,0,1)] motion-reduce:duration-0 hover:z-10 hover:shadow-[0_1.25rem_2.5rem_#1d1e211c] focus-within:z-10 focus-within:shadow-[0_1.25rem_2.5rem_#1d1e211c] max-mobile-landscape:min-h-0 max-mobile-landscape:pt-8">
            {/* Scales from the left edge so the bar draws in rather than fading. */}
            <div
              class="absolute inset-x-8 top-0 h-1 origin-left scale-x-0 bg-[#2aa555] transition-transform duration-600 ease-[cubic-bezier(0.625,0.05,0,1)] motion-reduce:duration-0 group-hover/step:scale-x-100 group-focus-within/step:scale-x-100"
              aria-hidden="true"
            />
            <p class="m-0 font-facultyglyphic text-4xl leading-normal font-normal text-[#2aa555]">
              {step.number}
            </p>
            <div>
              <h3 class="m-0 text-[1.375rem] leading-normal font-medium text-light-black">
                {step.title}
              </h3>
              <ul class="m-0 list-disc pl-6 text-base leading-normal text-[#1d1e2199] [&_li]:m-0">
                {step.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </div>
            {/* Reserves its own height at rest (mt-auto pins it to the bottom), so
                revealing it on hover cannot shift the text above it. */}
            <div class="mt-auto pt-5 opacity-0 transition-opacity duration-600 ease-[cubic-bezier(0.625,0.05,0,1)] motion-reduce:duration-0 group-hover/step:opacity-100 focus-within:opacity-100 max-mobile-landscape:opacity-100">
              <Button href="/request-a-demo" newTab={false}>
                Request a demo
              </Button>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
