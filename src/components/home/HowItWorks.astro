---
import Eyebrow from "../ui/Eyebrow.astro";
---

<section
  id="How-it-works"
  class="w-full bg-beige-dark py-25 max-mobile-landscape:py-14"
>
  <div class="container-medium">
    <Eyebrow label="VistIQ in action" line alignMobile="center" />
    <div
      class="mt-6 flex flex-col items-start gap-4 max-mobile-landscape:text-center"
    >
      <h2 class="heading font-facultyglyphic">
        Your firm's knowledge, working for you
      </h2>
    </div>

    <div
      class="relative z-0 mt-12 aspect-[1920/822] w-full overflow-hidden bg-sage max-mobile-landscape:mt-8 max-mobile-landscape:aspect-[4/3]"
    >
      <video
        data-how-it-works-video
        class="block h-full w-full object-cover"
        loop
        muted
        playsinline
        preload="metadata"
        aria-hidden="true"
      >
        <source src="/images/videos/system.webm" type="video/webm" />
        <source src="/images/videos/system.mp4" type="video/mp4" />
      </video>
    </div>
  </div>
</section>
