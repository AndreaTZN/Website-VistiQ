---
/** Closing call to action. */
import Button from "../ui/Button.astro";
import Corners from "../ui/Corners.astro";
import Eyebrow from "../ui/Eyebrow.astro";
---

<section
  class="sub-footer_section relative z-0 flex min-h-115 w-full items-center justify-center overflow-hidden bg-beige-dark py-25 max-mobile-landscape:min-h-0 max-mobile-landscape:py-14 max-mobile-landscape:[&_.corners_item]:hidden"
>
  {/* Same markup as the hero: scripts/globe-particles.js reuses the layer. */}
  <div class="hero-v2_anim" aria-hidden="true">
    <div class="hero-v2_anim-globe-gradient"></div>
    <div class="hero-v2_anim-canvas"></div>
  </div>

  <Corners />

  <div class="container-medium">
    <div class="mx-auto flex max-w-194 flex-col items-center gap-8">
      <div class="flex w-full flex-col items-center gap-4">
        <Eyebrow label="Get started" align="center" />
        <h2 class="heading is-centered">
          <span>Build your AI-native</span>
          <span> investment firm</span>
        </h2>
        <p
          class="m-0 text-xl leading-normal text-[#1d1e2199] max-mobile-landscape:text-lg text-center"
        >
          Connect your data. Activate your institutional memory. <br />
          Deploy your AI workforce.
        </p>
      </div>

      <div class="flex items-center justify-center gap-3.75">
        <Button variant="primary" href="/request-a-demo">
          Request a demo
        </Button>
      </div>
    </div>
  </div>
  <div class="noise"></div>
</section>
