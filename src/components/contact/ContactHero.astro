---
import Eyebrow from "../ui/Eyebrow.astro";
---

<section
  class="relative z-0 w-full overflow-hidden bg-beige-dark pt-48 pb-40 max-mobile-landscape:pt-36 max-mobile-landscape:pb-14"
>
  <div class="container-medium">
    <div class="mx-auto flex max-w-194 flex-col items-center gap-6">
      <Eyebrow label="Contact us" align="center" />

      <div class="flex w-full flex-col items-center gap-3">
        <h1
          class="m-0 bg-[linear-gradient(135deg,var(--color-light-black)_14%,rgb(117_117_117/0)_141%)] bg-clip-text text-center text-5xl leading-tight tracking-[-0.03rem] text-transparent max-mobile-landscape:text-[2.375rem]"
        >
          <span class="block">Get in touch</span>
        </h1>
        <p
          class="m-0 max-w-144 text-center text-lg leading-normal text-light-black/60"
        >
          Fill out the form below and we'll get back to you shortly.
        </p>
      </div>
    </div>
  </div>

  <div class="noise"></div>
</section>
