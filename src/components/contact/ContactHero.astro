---
import Eyebrow from "../ui/Eyebrow.astro";
---

<section class="contact-hero_section">
  <div class="container-medium">
    <div class="contact-hero_content">
      <Eyebrow label="Contact us" align="center" />

      <div class="contact-hero_text">
        <h1 class="contact-hero_heading">
          <span>Get in touch</span>
        </h1>
        <p class="contact-hero_paragraph">
          Fill out the form below and we'll get back to you shortly.
        </p>
      </div>
    </div>
  </div>

  <div class="noise"></div>
</section>
