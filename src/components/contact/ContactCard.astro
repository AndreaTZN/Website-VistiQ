---
/**
 * Contact — the whole page in one bordered white card, split in two columns
 * (Figma `contact v1`, node 1865:39646).
 *
 * Left: intro + one panel per office, each backed by its country map SVG.
 * Right: the form. There is still no backend in this repo — the form posts
 * JSON to whatever `action` resolves to and `scripts/contact-form.js` falls
 * back to the Typeform when no endpoint is configured or the request fails.
 */
import Eyebrow from "../ui/Eyebrow.astro";

const TYPEFORM_URL = "https://foundersfuturecp.typeform.com/to/gTW2mUSp";

/** Empty unless the deploy sets it — the script then uses the Typeform. */
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT ?? "";

const CATEGORIES = [
  "Request a demo",
  "Sales & pricing",
  "Partnership",
  "Press & media",
  "Careers",
  "Support",
  "Other",
];

/**
 * `map` is positioned inside its 229px-tall panel with the same crop as the
 * Figma frame, and `pin` sits on top of it — both in percentages so the panel
 * can grow with the fluid root font-size instead of pinning to a pixel canvas.
 */
const OFFICES = [
  {
    flag: "🇺🇸",
    title: "Miami US Office",
    lines: ["929 Alton Rd Ste 500", "Miami, FL 33139"],
    map: "/images/contact/map-usa.svg",
    mapClass: "left-[-8.4%] top-[-135%] h-[199.8%] w-[114.2%]",
    pin: "left-[89.2%] top-[55%]",
  },
  {
    flag: "🇫🇷",
    title: "Paris Headquarters",
    lines: ["29 Rue de Choiseul", "75002, Paris, France"],
    map: "/images/contact/map-france.svg",
    mapClass: "left-[45.2%] top-[5.7%] h-[192.1%] w-[76.4%]",
    pin: "left-[80.6%] top-[48.5%]",
  },
];

const fieldClass =
  "contact_input w-full rounded-[0.545rem] border-[0.045rem] border-[#e9eaf0] bg-white px-[0.727rem] py-[0.727rem] font-inter text-sm leading-normal text-light-black shadow-[0_0.09rem_0.18rem_rgba(0,0,0,0.08)] transition-[border-color,box-shadow] duration-300 ease-[cubic-bezier(0.455,0.03,0.515,0.955)] placeholder:text-light-black/30 focus:border-light-black focus:outline-none";

const labelClass = "m-0 text-sm leading-normal text-light-black";
---

<section class="relative z-0 w-full overflow-hidden bg-beige-dark py-25">
  <div class="container-medium relative z-1">
    <div
      class="grid grid-cols-2 overflow-hidden rounded border border-[#e8e8e9] bg-white max-tablet:grid-cols-1"
    >
      <!-- Left column: intro + one panel per office -->
      <div
        class="flex flex-col border-r border-[#e8e8e9] max-tablet:border-r-0 max-tablet:border-b"
      >
        <div class="flex flex-col items-start gap-3 p-6">
          <Eyebrow label="Contact us" />
          <h1
            class="bg-[linear-gradient(74deg,var(--color-light-black)_29%,rgb(117_117_117/0)_163%)] bg-clip-text font-facultyglyphic text-[2rem] leading-[1.2] tracking-[-0.02rem] text-transparent"
          >
            Get in Touch
          </h1>
          <p class="m-0 text-base leading-normal text-light-black/60">
            We'd love to hear from you. <br />
            Send us a message and we'll respond as soon as possible.
          </p>
        </div>

        {
          OFFICES.map((office, index) => (
            <div
              class:list={[
                "relative h-57.25 overflow-hidden border-t border-[#e8e8e9]",
                index === OFFICES.length - 1 && "border-b-0",
              ]}
            >
              <img
                class:list={[
                  "pointer-events-none absolute max-w-none select-none",
                  office.mapClass,
                ]}
                src={office.map}
                alt=""
                aria-hidden="true"
                loading="lazy"
                decoding="async"
              />

              {/* Halo + dot were two SVG circles in Figma — a ring and a filled
                  disc do the same thing without two extra requests. The halo
                  is its own layer so scripts/contact-pins.js can pulse it
                  without the dot inheriting the scale. */}
              <span
                class:list={[
                  "contact_pin pointer-events-none absolute size-[2.05rem] -translate-x-1/2 -translate-y-1/2",
                  office.pin,
                ]}
                data-contact-pin
                aria-hidden="true"
              >
                <span
                  class="absolute inset-0 rounded-full bg-green/20"
                  data-contact-pin-halo></span>
                <span
                  class="absolute top-1/2 left-1/2 size-[1.025rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-green"
                ></span>
              </span>

              <div class="absolute bottom-6 left-6 flex flex-col gap-4">
                <p class="m-0 text-xl leading-normal font-medium text-light-black">
                  <span aria-hidden="true">{office.flag}</span> {office.title}
                </p>
                <div class="flex flex-col">
                  <p class="m-0 text-base leading-normal text-light-black">
                    Address
                  </p>
                  <p class="m-0 text-sm leading-normal text-light-black/60">
                    {office.lines.map((line, i) => (
                      <>
                        {i > 0 && <br />}
                        {line}
                      </>
                    ))}
                  </p>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Right column: the form, vertically centred against the left stack -->
      <div class="flex items-center justify-center p-6">
        <div class="flex w-full max-w-122.25 flex-col gap-6">
          <p class="m-0 text-center text-2xl leading-normal text-light-black">
            Send a message
          </p>

          <form
            class="flex w-full flex-col"
            data-contact-form
            data-fallback={TYPEFORM_URL}
            action={endpoint}
            method="post"
            novalidate
          >
            <div
              class="flex gap-6 max-mobile-landscape:flex-col max-mobile-landscape:gap-0"
            >
              <div class="flex flex-1 flex-col gap-1 pb-6">
                <label class={labelClass} for="contact-name">Name</label>
                <input
                  class={fieldClass}
                  id="contact-name"
                  name="name"
                  type="text"
                  autocomplete="name"
                  placeholder="Your name"
                  required
                />
              </div>

              <div class="flex flex-1 flex-col gap-1 pb-6">
                <label class={labelClass} for="contact-email">Email</label>
                <input
                  class={fieldClass}
                  id="contact-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  placeholder="you@email.com"
                  required
                />
              </div>
            </div>

            <div class="flex flex-col gap-1 pb-6">
              <label class={labelClass} for="contact-category">Category</label>
              <select
                class={`contact_select ${fieldClass} cursor-pointer appearance-none bg-[url('data:image/svg+xml,%3Csvg_xmlns=%27http://www.w3.org/2000/svg%27_width=%2716%27_height=%2716%27_fill=%27none%27%3E%3Cpath_stroke=%27%231d1e21%27_stroke-width=%271.5%27_stroke-linecap=%27round%27_stroke-linejoin=%27round%27_d=%27m4_6_4_4_4-4%27/%3E%3C/svg%3E')] bg-position-[right_0.727rem_center] bg-no-repeat pr-10`}
                id="contact-category"
                name="category"
                required
              >
                <option value="" selected disabled>Select a category</option>
                {
                  CATEGORIES.map((category) => (
                    <option value={category}>{category}</option>
                  ))
                }
              </select>
            </div>

            <div class="flex flex-col gap-1 pb-6">
              <label class={labelClass} for="contact-message">Message</label>
              <textarea
                class={`${fieldClass} h-25 resize-y`}
                id="contact-message"
                name="message"
                rows="4"
                placeholder="How can we help"
                required></textarea>
            </div>

            {/* Honeypot: bots fill it, humans never see it. */}
            <div
              class="absolute h-px w-px overflow-hidden [clip-path:inset(50%)] whitespace-nowrap"
              aria-hidden="true"
            >
              <label for="contact-company-website">Leave this field empty</label
              >
              <input
                id="contact-company-website"
                name="companyWebsite"
                type="text"
                tabindex="-1"
                autocomplete="off"
              />
            </div>

            <div class="flex w-full flex-col gap-6">
              <button
                class="contact_submit w-full cursor-pointer rounded-lg border-none bg-[linear-gradient(to_top,#0c0c0c_50%,#aca094_217%)] px-4 py-2.5 font-inter text-sm leading-normal font-medium tracking-[-0.00875rem] text-white shadow-[inset_0_-0.125rem_0.0625rem_#ffffff0d,inset_0_0.0625rem_0.0375rem_#00000080] filter-[drop-shadow(0_0.125rem_0.1875rem_#0c0c0c33)] transition-opacity duration-300 ease-[cubic-bezier(0.455,0.03,0.515,0.955)] hover:opacity-85 disabled:cursor-default disabled:opacity-60"
                type="submit"
                data-contact-submit
              >
                <span data-contact-submit-label>Send Message</span>
              </button>

              <p
                class="m-0 text-center text-sm leading-normal text-light-black/60"
              >
                By sending this form you agree to <a
                  href="/privacy-policy"
                  class="text-light-black underline">privacy policy.</a
                >
              </p>
            </div>

            {
              /* Filled by scripts/contact-form.js; polite so it never interrupts. */
            }
            <p
              class="contact_status m-0 pt-4 text-center text-sm leading-normal text-light-black/60 empty:hidden"
              data-contact-status
              role="status"
              aria-live="polite"
            >
            </p>
          </form>
        </div>
      </div>
    </div>
  </div>

  <div class="noise"></div>
</section>
