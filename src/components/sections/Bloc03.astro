---
/**
 * "What it does for you" — Figma 1525:4699 (closed) / 1525:10472 (open).
 * Accordion: one panel open at a time, animated in scripts/accordion.js.
 */
import Corners from "../ui/Corners.astro";

const ITEMS = [
  {
    eyebrow: "Ask anything",
    title: "Ask your portfolio",
    body: "Ask in plain language. Vistiq answers from every deal, document and conversation you already have, with the source attached.",
  },
  {
    eyebrow: "AUTOMATIC DATA ENTRY",
    title: "No manual entry - every document is integrated on its own",
    body: "Decks, board packs, monthly updates, LP emails. The Analyst reads the document, matches the company, extracts the KPIs and files them in the portfolio. Nothing is retyped, nothing is reformatted.",
  },
  {
    eyebrow: "CONNECTORS",
    title: "Connected to your data and to the tools your team already works in",
    body: "Gmail, Outlook, Google Drive, Excel and your dataroom. Documents reach VistiQ where they already land no new habit to adopt, no folder to maintain.",
  },
  {
    eyebrow: "Portfolio monitoring",
    title:
      "A portfolio that is always up to date, and the health of every company in real time",
    body: "NAV, KPIs, ownership, runway and headcount move the day a document arrives not the month the master file is rebuilt. Every figure clicks back to its source.",
  },
  {
    eyebrow: "COLLABORATIVE DEALFLOW",
    title:
      "The whole deal team on the same file, from first deck to signed term sheet",
    body: "Pitch deck, IC memo, committee decision, term sheet, meeting minutes, reference calls. Each step records who contributed and what they said the deal history stays in the fund, not in an inbox.",
  },
  {
    eyebrow: "Fund operations and reporting",
    title: "Create customized LP reportings",
    body: "AI agents orchestrating every investment vehicles, from funds and co-investment SPVs and holdings, with automated governance, reporting, and investor communications.",
  },
];
---

<section id="Solutions" class="home-bloc03_section">
  <div class="container-medium">
    <div class="home-bloc03_header">
      <div class="home-bloc03_tag">
        <div class="home-bloc03_eyebrow">
          <span class="home-bloc03_square" aria-hidden="true"></span>
          <span class="home-bloc03_eyebrow-label">What it does for you</span>
        </div>
        <div class="home-bloc03_line"></div>
      </div>
      <h2 class="heading">10x your investment team</h2>
    </div>

    <div class="home-bloc03_layout">
      <div class="home-bloc03_accordion" data-accordion>
        {
          ITEMS.map((item, index) => (
            <div class="home-bloc03_item" data-accordion-item>
              {/* Per-slide visual, mobile only — the desktop layout uses the
                  single shared one below and hides these. */}
              <div class="home-bloc03_item-visual" aria-hidden="true">
                <Corners />
                <div class="noise" />
              </div>
              <div class="home-bloc03_item-line" />
              <h3 class="home-bloc03_item-heading">
                <button
                  type="button"
                  class="home-bloc03_item-trigger"
                  data-accordion-trigger
                  aria-expanded={index === 0 ? "true" : "false"}
                  aria-controls={`bloc03-panel-${index}`}
                  id={`bloc03-trigger-${index}`}
                >
                  <span class="home-bloc03_item-eyebrow">
                    <span
                      class="home-bloc03_item-square"
                      data-accordion-square
                      aria-hidden="true"
                    />
                    <span class="home-bloc03_item-eyebrow-label">
                      {item.eyebrow}
                    </span>
                  </span>
                  <span class="home-bloc03_item-title">{item.title}</span>
                </button>
              </h3>
              {item.body && (
                <div
                  class="home-bloc03_item-panel"
                  data-accordion-panel
                  id={`bloc03-panel-${index}`}
                  role="region"
                  aria-labelledby={`bloc03-trigger-${index}`}
                >
                  <p class="home-bloc03_item-body">{item.body}</p>
                </div>
              )}
            </div>
          ))
        }
      </div>

      <div class="home-bloc03_visual" data-accordion-visual>
        <Corners />
        <div class="noise"></div>
      </div>
    </div>
  </div>
</section>
