---
/** Steps of the investment lifecycle. */
import Corners from "../ui/Corners.astro";
import Eyebrow from "../ui/Eyebrow.astro";

const STEPS = [
  {
    number: "01",
    title: "Deal assessment",
    paragraphs: [
      "Centralized pipeline with AI scoring, pitch deck analysis, automated risk assessment and auto-generated IC memos.",
      "Go from sourcing to signature without friction.\nA collaborative workspace where specialized AI agents work alongside your investment team from opportunity scoring and pitch deck analysis to IC memo drafting, due diligence orchestration, and closing.",
    ],
  },
  {
    number: "02",
    title: "Portfolio monitoring",
    paragraphs: [
      "AI-powered dashboards, quantitative & qualitative KPIs, proactive alerts and exit scenario modeling.",
      "Stay ahead of every portfolio company, in real time.",
      "Your AI portfolio team, continuously monitoring real time every company, coordinating reporting, identifying risks and opportunities, and preparing the path to liquidity.",
    ],
  },
  {
    number: "03",
    title: "Fund operations and reporting",
    paragraphs: [
      "AI agents orchestrating every investment vehicles, from funds and co-investment SPVs and holdings, with automated governance, reporting, and investor communications.",
    ],
  },
];
---

<section class="home-bloc02_section">
  <div class="home-bloc02_pattern" aria-hidden="true"></div>

  <Corners />

  <div class="container-medium">
    <div class="home-bloc02_header">
      <Eyebrow label="End-to-end coverage" align="center" />
      <h2 class="heading is-centered">
        <span>End-to-end solution covering</span>
        <span>the full investment lifecycle</span>
      </h2>
    </div>

    <ol class="home-bloc02_steps">
      {
        STEPS.map((step) => (
          <li class="home-bloc02_step">
            <div class="home-bloc02_step-line" />
            <p class="home-bloc02_step-number">{step.number}</p>
            <div class="home-bloc02_step-text">
              <h3 class="home-bloc02_step-title">{step.title}</h3>
              <div class="home-bloc02_step-body">
                {step.paragraphs.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
