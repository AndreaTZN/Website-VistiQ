---
import Eyebrow from "../ui/Eyebrow.astro";
---

<section id="How-it-works" class="how-it-works_section">
  <div class="container-medium">
    <Eyebrow label="How the system works" line alignMobile="center" />
    <div class="how-it-works_text">
      <h2 class="heading">
        <span>Your knowledge is the asset.</span>
        <span>Your memory is the leverage.</span>
      </h2>
      <div class="opacity-70">
        <p class="how-it-works_paragraph">
          Decks, memos, board packs, calls one firm memory, sourced and
          searchable. <br />
          Connect VistIQ to your existing tools once, CRM, data rooms, email, cloud
          storage, portfolio systems, and more. Every deck, dataset, and conversation
          flows into a single, always current knowledge base.
        </p>
      </div>
    </div>

    <div class="how-it-works_visual">
      <div class="noise"></div>
    </div>
  </div>
</section>
