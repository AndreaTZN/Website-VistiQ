---
/** Closing call to action — Figma 1525:40015. */
import Button from "../ui/Button.astro";
import Corners from "../ui/Corners.astro";
---

<section class="sub-footer_section">
  {/* Same markup as the hero: scripts/globe-particles.js reuses the layer. */}
  <div class="hero-v2_anim" aria-hidden="true">
    <div class="hero-v2_anim-globe-gradient"></div>
    <div class="hero-v2_anim-canvas"></div>
  </div>

  <Corners />

  <div class="container-medium">
    <div class="sub-footer_content">
      <div class="sub-footer_text">
        <div class="sub-footer_eyebrow">
          <span class="sub-footer_square" aria-hidden="true"></span>
          <span class="sub-footer_eyebrow-label">Get started</span>
        </div>
        <h2 class="sub-footer_heading">
          <span>10x your investment</span>
          <span>team with AI</span>
        </h2>
        <p class="sub-footer_paragraph">
          Delegate the maintenance of your AI infrastructure
        </p>
      </div>

      <div class="sub-footer_buttons">
        <Button
          variant="hero-primary"
          href="https://foundersfuturecp.typeform.com/to/gTW2mUSp"
        >
          Test the solution
        </Button>
        <Button
          variant="hero-secondary"
          href="https://foundersfuturecp.typeform.com/to/gTW2mUSp"
        >
          Contact us
        </Button>
      </div>
    </div>
  </div>
  <div class="noise"></div>
</section>
