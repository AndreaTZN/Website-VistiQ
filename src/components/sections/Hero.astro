---
import Button from "../ui/Button.astro";
---

<section class="hero2_section">
  <div class="container-medium">
    <div class="hero2_text-wrap">
      <div class="hero2_content-block">
        <p class="hero2_eyebrow">
          <span class="text-span">Connect your data.</span>
          <span>Monitor in real time.</span>
          <span>Decide with conviction.</span>
        </p>
        <h1 class="hero_heading">
          The AI investment operating system for private markets
        </h1>
        <p class="opacity-75">
          VistIQ connects deal flow, portfolio data, fund activity, and external
          signals into a single intelligence layer. It automates extraction,
          monitoring, and reporting so your team stops chasing information and
          starts acting on it.
        </p>
      </div>
      <div class="hero_button">
        <Button
          variant="secondary-white"
          href="https://foundersfuturecp.typeform.com/to/gTW2mUSp"
          label="Request early access"
        >
          Request early access
        </Button>
      </div>
    </div>
    <div class="hero2_illu-wrap">
      <div class="hero2_illu">
        <img
          src="/images/hero_1.avif"
          loading="lazy"
          alt="Dashboard interface of Founders Future showing Copilot chat analyzing portfolio risk with five companies flagged as most at risk and recent query buttons below."
          class="image-full"
        />
      </div>
