---
/** "Security & compliance" — Figma 1433:13331. */
import Button from "../ui/Button.astro";

const PILLARS = [
  {
    number: "01",
    title: "Confidentiality",
    paragraphs: [
      "Your organization data are fully isolated by design, ensuring strict separation between clients.",
      "Your data is not used to train LLM models.",
    ],
  },
  {
    number: "02",
    title: "Auditability",
    paragraphs: [
      "Every AI-generated output is backed by a traceable source. Click any reference number to access the source document.",
      "Comprehensive audit logs provide full visibility into AI and user modifications.",
    ],
  },
  {
    number: "03",
    title: "Confidentiality",
    paragraphs: [
      "Your proprietary data are hosted within the EU, following strict enterprise-grade security standards.",
    ],
  },
];
---

<section id="Data" class="home-bloc06_section">
  <div class="container-medium">
    <div class="home-bloc06_header">
      <div class="home-bloc06_tag">
        <div class="home-bloc06_eyebrow">
          <span class="home-bloc06_square" aria-hidden="true"></span>
          <span class="home-bloc06_eyebrow-label"
            >Security &amp; compliance</span
          >
        </div>
        <div class="home-bloc06_line"></div>
      </div>

      <div class="home-bloc06_intro">
        <div class="home-bloc06_intro-text">
          <h2 class="heading">
            <span>Built for confidentiality,</span>
            <span>auditability and security</span>
          </h2>
          <p class="home-bloc06_paragraph">
            Designed from day one with the compliance teams of investment funds.
          </p>
        </div>
      </div>
    </div>

    <ol class="home-bloc06_pillars">
      {
        PILLARS.map((pillar) => (
          <li class="home-bloc06_pillar">
            <div class="home-bloc06_pillar-line" />
            <div class="home-bloc06_pillar-body">
              <p class="home-bloc06_pillar-number">{pillar.number}</p>
              <div class="home-bloc06_pillar-text">
                <h3 class="home-bloc06_pillar-title">{pillar.title}</h3>
                {pillar.paragraphs.map((paragraph) => (
                  <p class="home-bloc06_pillar-paragraph">{paragraph}</p>
                ))}
              </div>
            </div>
          </li>
        ))
      }
    </ol>
    <div class="home-bloc06_buttons">
      <Button
        variant="hero-primary"
        href="https://foundersfuturecp.typeform.com/to/gTW2mUSp"
      >
        Test the solution
      </Button>
      <Button
        variant="hero-secondary"
        href="https://foundersfuturecp.typeform.com/to/gTW2mUSp"
      >
        Contact us
      </Button>
    </div>
  </div>
</section>
