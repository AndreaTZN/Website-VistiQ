---
interface Props {
  /** Optional destination — the bar renders as a plain <div> when omitted. */
  href?: string;
}

const { href } = Astro.props;
const Tag = href ? "a" : "div";
---

<div class="announcement_component">
  <Tag
    class="announcement_inner"
    {...href ? { href, rel: "noopener" } : {}}
  >
    <span class="announcement_text">Exhibiting at IPEM Paris (8–10 Sept. 2026)</span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 16 16"
      fill="none"
      aria-hidden="true"
      class="announcement_arrow"
    >
      <path
        d="M3.333 8h9.334m0 0L9.333 4.667M12.667 8l-3.334 3.333"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </Tag>
</div>
